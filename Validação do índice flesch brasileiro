#Função para calcular o índice de leiturabilidade
def calcular_total(total_palavras, quantidade_frases, total_silabas):
    total = ( 248.835 - (1.015 * (total_palavras / quantidade_frases)) - (84.6 * (total_silabas / total_palavras)) )
    return total

