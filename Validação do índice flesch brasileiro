#Total de silabas
def contar_silabas_pt(texto):
    dic = pyphen.Pyphen(lang='pt_BR')
    palavras = texto.split()
    total_silabas = 0

    for palavra in palavras:
        silabas = dic.inserted(palavra).split('-')
        total_silabas += len(silabas)

    return total_silabas

